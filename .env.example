# ─── Backend environment variables ────────────────────────────────────────────
# Copy this file to backend/.env and fill in the real values.
# NEVER commit backend/.env to version control.

# Google OAuth Client ID (from Google Cloud Console → Credentials → OAuth 2.0 Client IDs)
# Required for Google Sign-In verification on the backend.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Frontend environment variables ───────────────────────────────────────────
# Copy this section to web/.env (already created by you).
# VITE_ prefix exposes the variable to the React build.

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

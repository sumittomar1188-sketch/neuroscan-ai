# ─── Backend environment variables ────────────────────────────────────────────
# Copy this file to backend/.env and fill in the real values.
# NEVER commit backend/.env to version control.

# Google OAuth Client ID (from Google Cloud Console → Credentials → OAuth 2.0 Client IDs)
# Required for Google Sign-In verification on the backend.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Model File Path (optional, defaults to ./brain_tumor_resnet50.keras or ./models/brain_tumor_resnet50.keras)
# For Railway / cloud deployment, provide the path to your mounted or downloaded model:
# MODEL_PATH=/app/models/brain_tumor_resnet50.keras

# Database URL (optional, defaults to SQLite ./neuroscan.db for local development)
# For Railway PostgreSQL: postgresql://postgres:password@host:port/railway
# DATABASE_URL=sqlite:///./neuroscan.db

# Allowed CORS Origins (optional, comma-separated list)
# Default already includes https://neuroscan-ai-murex.vercel.app and localhost
# ALLOWED_ORIGINS=https://neuroscan-ai-murex.vercel.app,http://localhost:5173

# ─── Frontend environment variables ───────────────────────────────────────────
# Copy this section to web/.env.
# VITE_ prefix exposes the variable to the React build.

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Target Backend Server URL
# In local development: defaults to http://localhost:8000
# In production on Vercel: set to your deployed Railway backend URL
VITE_API_BASE_URL=https://your-backend-app.up.railway.app
